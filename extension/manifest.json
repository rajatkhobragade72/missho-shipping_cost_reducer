{
  "manifest_version": 3,
  "name": "Meesho Shipping Optimizer",
  "version": "0.3.1",
  "description": "Tries framed versions of your Meesho front image, reads the real shipping charge for each, and keeps the cheapest. Also uploads your other photos.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://supplier.meesho.com/*", "https://*.meesho.com/*", "http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://supplier.meesho.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Meesho page par: Shipping Optimizer panel dikhao/chhupao.",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  }
}
